{
  "name": "Cashout · Solana + Anchor",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Frontend (Next.js)" } },
  "customizations": {
    "vscode": { "extensions": ["rust-lang.rust-analyzer", "dbaeumer.vscode-eslint"] }
  }
}
