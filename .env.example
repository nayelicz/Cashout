# Copia a web/.env.local (o ejecuta `yarn sync-env` desde .env en la raíz).
# Todas son públicas; este proyecto no necesita llaves privadas en el frontend.

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ID desplegado en devnet (se actualiza solo con `anchor keys sync`; ver README)
NEXT_PUBLIC_PROGRAM_ID=J81oZe4fJT4C1pkxx9F5uXhFmDT1iDUw1FhEY8LWwhe3

# Token SPL de la remesa. Usa el que imprime `yarn demo-token:devnet`.
NEXT_PUBLIC_USDC_MINT=

# Comercio preseleccionado opcional en el formulario de reserva (puede quedar vacío)
NEXT_PUBLIC_FALLBACK_MERCHANT_PUBKEY=

# ── Opcionales (integraciones del proyecto base fuera del flujo evaluado) ─────────────
# ELEVENLABS_API_KEY=
# RENDER_BACKEND_URL=
# BOT_INTERNAL_SECRET=
